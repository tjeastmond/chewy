#!/usr/bin/env node

import { existsSync, mkdirSync } from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const __filename = fileURLToPath(import.meta.url)
const __dirname = path.dirname(__filename)

const HELP_TEXT = `Usage: chewy [options]
       chewy clean [options]

Description:
  Export resume JSON into HTML, PDF, JSON, CSV, YAML, and TXT.
  Requires a TTY terminal for export prompts.

Commands:
  clean                   Remove all files in the output directory

Options:
  -h, --help              Show this help message
  -i, --input <path>      Resume JSON path (default: ./resume.json)
  -o, --out-dir <path>    Output directory (default: ./out)
  -f, --format <list>     all or comma-separated formats:
                          html,pdf,json,csv,yaml,txt
      --summary <key>     Summary key from summaries (default: default)
      --template <path>   Custom Handlebars template path

Examples:
  chewy --input ./resume.json
  chewy --input ./resume.json --format html,pdf --out-dir ./out
  chewy --input ./resume.json --summary backend
  chewy clean
  chewy clean --out-dir ./out
`

function wantsHelp(argv) {
  return argv.includes('--help') || argv.includes('-h')
}

function wantsClean(argv) {
  return argv[0] === 'clean'
}

function maybeCreateOutDir(argv) {
  const long = argv.indexOf('--out-dir')
  const short = argv.indexOf('-o')
  const i = long !== -1 ? long : short
  const v = i === -1 ? 'out' : argv[i + 1]
  if (!v) return

  const outDir = path.resolve(process.cwd(), v)
  mkdirSync(outDir, { recursive: true })
}

const distCliPath = path.resolve(__dirname, '../dist/cli.js')
const argv = process.argv.slice(2)

if (wantsHelp(argv)) {
  process.stdout.write(`${HELP_TEXT}\n`)
  process.exit(0)
}

if (!existsSync(distCliPath)) {
  // Keep the output readable (especially when invoked from other scripts).
  console.error('\nchewy: missing build output at dist/cli.js\n\nRun: pnpm build\n')
  process.exitCode = 1
} else {
  if (!wantsClean(argv)) {
    maybeCreateOutDir(argv)
  }
  const mod = await import(distCliPath)
  if (typeof mod.runCli !== 'function') {
    console.error('\nchewy: dist/cli.js did not export runCli()\n')
    process.exitCode = 1
  } else {
    await mod.runCli()
  }
}
